# These four are injected automatically once you attach a Vercel KV store
# to this project in the Vercel dashboard (Storage tab -> Create -> KV).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# Injected automatically once you attach a Vercel Blob store
# (Storage tab -> Create -> Blob).
BLOB_READ_WRITE_TOKEN=

# You must set this one yourself — any long random string.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
